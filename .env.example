# Copy to .env for local dev. NEVER commit a real .env (see .gitignore).
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-every-environment
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.localhost

# Apex domain used to derive tenant subdomains (acme.localhost -> "acme")
BASE_DOMAIN=localhost

# PostgreSQL (django-tenants backend)
POSTGRES_DB=nina
POSTGRES_USER=nina
POSTGRES_PASSWORD=nina
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=true

# Observability
SENTRY_DSN=
DJANGO_LOG_LEVEL=INFO
