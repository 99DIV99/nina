FROM pytorch/pytorch:2.1.0-cpu-only

WORKDIR /app

# Install only the additional dependencies (torch already installed)
RUN pip install --no-cache-dir \
    transformers>=4.37.0 \
    accelerate>=0.25.0 \
    fastapi>=0.109.0 \
    uvicorn[standard]>=0.27.0 \
    pydantic>=2.0.0 \
    httpx>=0.25.0

# Copy the Qwen server code
COPY qwen-app/server.py /app/

# Expose port
EXPOSE 8000

# Run server
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8000"]
