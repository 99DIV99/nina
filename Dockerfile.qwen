FROM python:3.10-slim

WORKDIR /app

# Use torch from CPU index, skip torchvision/torchaudio (not needed)
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu \
    torch==2.1.0+cpu && \
    pip install --no-cache-dir --upgrade pip

# Install other dependencies (4.37+ needed for Qwen2 support)
# Set TRANSFORMERS_NO_TEVOS to avoid distributed tensor requirements

RUN pip install --no-cache-dir \
    transformers==4.37.2 \
    accelerate==0.25.0 \
    fastapi==0.109.0 \
    uvicorn==0.27.0 \
    pydantic==2.5.0 \
    httpx==0.25.2 \
    sentencepiece==0.1.99

# Copy the Qwen server code
COPY qwen-app/server.py /app/

# Expose port
EXPOSE 8000

# Run server
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8000"]
