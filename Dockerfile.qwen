FROM pytorch/pytorch:2.1.2-cpu

WORKDIR /app

# Install Python dependencies (transformers 4.35 doesn't require DTensor)
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
    transformers==4.35.2 \
    accelerate==0.24.1 \
    fastapi==0.109.0 \
    uvicorn[standard]==0.27.0 \
    pydantic==2.5.0 \
    httpx==0.25.2 \
    sentencepiece==0.1.99

# Copy the Qwen server code
COPY qwen-app/server.py /app/

# Expose port
EXPOSE 8000

# Run server
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8000"]
