# Copy to .env.prod on the VPS and fill real values. NEVER commit .env.prod.
# Generate a secret: python -c "import secrets; print(secrets.token_urlsafe(64))"

# Use staging settings for an HTTP-first bring-up (no forced HTTPS redirect).
# Switch to config.settings.prod once wildcard TLS is in place.
DJANGO_SETTINGS_MODULE=config.settings.staging
DJANGO_SECRET_KEY=CHANGE-ME-long-random-string
DJANGO_DEBUG=false

# Apex + wildcard. The leading dot allows every tenant subdomain.
BASE_DOMAIN=yourdomain.com
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,.yourdomain.com

# PostgreSQL (POSTGRES_HOST is overridden to `db` by compose)
POSTGRES_DB=nina
POSTGRES_USER=nina
POSTGRES_PASSWORD=CHANGE-ME-strong-db-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Celery / Redis (overridden to the redis service by compose)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=false

# Email (swap console backend for a real provider before going live)
DEFAULT_FROM_EMAIL=no-reply@yourdomain.com
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Observability
SENTRY_DSN=
DJANGO_LOG_LEVEL=INFO
