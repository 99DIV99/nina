# Env for the DEV Docker stack (backend + frontend + db + redis).
# Copy to .env.dev on the VPS and fill real values. NEVER commit .env.dev.
# Generate a secret: python -c "import secrets; print(secrets.token_urlsafe(64))"

# ---- Django backend -------------------------------------------------------
# Dev settings: DEBUG=True, console email. runserver serves static.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=CHANGE-ME-long-random-string

# Dev apex + wildcard. (dev.py forces ALLOWED_HOSTS=["*"], but keep this accurate.)
BASE_DOMAIN=dev.ninax.net
DJANGO_ALLOWED_HOSTS=dev.ninax.net,.dev.ninax.net,admin.dev.ninax.net

# PostgreSQL — SEPARATE dev database (own volume; POSTGRES_HOST overridden to `db`).
POSTGRES_DB=nina_dev
POSTGRES_USER=nina_dev
POSTGRES_PASSWORD=CHANGE-ME-strong-dev-db-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Celery / Redis (overridden to the redis service by compose). A real worker runs
# in dev, so do NOT run tasks eagerly.
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=false

# SMS: console provider logs the OTP code instead of sending it — the full
# signup/login flow works with ZERO real SMS. Read the code from `docker logs`.
SMS_PROVIDER=console

# Email + observability
DEFAULT_FROM_EMAIL=no-reply@dev.ninax.net
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
SENTRY_DSN=
DJANGO_LOG_LEVEL=INFO

# ---- Next.js frontend -----------------------------------------------------
# Baked into nina-frontend:dev at build (compose passes these as build args).
# Dev is single-domain: host routing AND the API both live on dev.ninax.net.
NINA_BASE_DOMAIN=dev.ninax.net
NINA_API_PROTO=https
NINA_API_PORT=443
NINA_API_BASE=https://dev.ninax.net
